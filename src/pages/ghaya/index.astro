---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sheet from "@/components/Sheet.astro";
import { DeepDiagramSection } from "@/components/DeepDiagramSection";
import { DeepDecisions } from "@/components/DeepDecisions";
import { BugsGrid } from "@/components/BugsGrid";
import { ghayaDeep } from "@/data/projects";
---
<BaseLayout title="Ghaya Go, under the hood — Salah Joja" description="How Salah Joja built the Ghaya Go NestJS API: routes, Redis caching, and two bugs he fixed.">
  <nav class="text-sm"><a href="/" class="underline-offset-4 hover:underline">Salah Joja</a></nav>

  <Sheet meta="Education & curriculum management · pre-launch · private repo">
    <h1 slot="title" class="text-2xl font-semibold tracking-tight md:text-3xl">Ghaya Go, under the hood</h1>
    <p class="prose-measure">One NestJS API serving an Expo mobile app and a Next.js CMS from a Turborepo monorepo. I was the main backend engineer from February to August 2026, and I wrote it from an empty repository.</p>
    <p class="text-sm text-muted-foreground">There is no live traffic, so no number on this page comes from production.</p>
    <p class="mt-4 text-xs text-muted-foreground">Expo app the API served (not my UI work).</p>
    <div class="mt-2 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {["home-learn","lesson","leaderboard","quests"].map((name) => (
        <figure class="m-0 text-center">
          <img src={`/ghaya/${name}.webp`} alt="" width={780} height={1690} loading="lazy" class="mx-auto w-full max-w-[220px] rounded-md border" />
          <figcaption class="mt-1 text-xs capitalize text-muted-foreground">{name.replace("-"," ")}</figcaption>
        </figure>
      ))}
    </div>
  </Sheet>

  <Sheet>
    <h2 slot="title" class="text-xl font-semibold">The shape</h2>
    <p class="prose-measure">The CMS never writes curriculum tables directly. It calls signed API endpoints, so every business rule lives in one place and every editorial write lands in an audit log.</p>
    <DeepDiagramSection client:load diagrams={ghayaDeep.diagrams} />
    <div class="overflow-x-auto text-sm">
      <table class="w-full border-collapse">
        <caption class="mb-2 text-left font-semibold">API surface</caption>
        <thead><tr class="border-b text-left"><th class="py-2 pr-4">Route</th><th class="py-2 pr-4">Routes</th><th class="py-2 pr-4">Caller</th><th class="py-2">Authorization</th></tr></thead>
        <tbody class="text-muted-foreground">
          <tr class="border-b"><th scope="row" class="py-2 pr-4 font-mono text-foreground">/users/me/*</th><td>22</td><td>Mobile learner</td><td>Clerk JWT</td></tr>
          <tr class="border-b"><th scope="row" class="py-2 pr-4 font-mono text-foreground">/cms/v1/*</th><td>28</td><td>CMS editor</td><td>Service key and signed actor ID</td></tr>
          <tr class="border-b"><th scope="row" class="py-2 pr-4 font-mono text-foreground">/courses, /health/*</th><td>4</td><td>Public, orchestrator, payment provider</td><td>None, or a signature</td></tr>
        </tbody>
        <tfoot><tr><th scope="row" class="py-2 pr-4">Total</th><td>54</td><td colspan="2">About 204 automated tests, about 65% API coverage</td></tr></tfoot>
      </table>
    </div>
    <p class="mt-3 text-sm text-muted-foreground">The payment webhook and the billing code around it exist in the repository, but I didn't build them.</p>
  </Sheet>

  <Sheet>
    <h2 slot="title" class="text-xl font-semibold">Decisions I'd defend</h2>
    <DeepDecisions client:load diagrams={ghayaDeep.diagrams} decisions={ghayaDeep.decisions} />
  </Sheet>

  <Sheet>
    <h2 slot="title" class="text-xl font-semibold">Two bugs I fixed</h2>
    <BugsGrid client:load bugs={ghayaDeep.bugs} diagrams={ghayaDeep.diagrams} />
    <nav class="mt-6 flex flex-col gap-2 text-sm font-medium">
      <a href="/ribat/" class="underline-offset-4 hover:underline">Next: Ribat, under the hood</a>
      <a href="/" class="underline-offset-4 hover:underline">Back to the home page</a>
    </nav>
  </Sheet>
</BaseLayout>
